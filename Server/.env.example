# PostgreSQL / Supabase Connection
# Direct connection string format:
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your-supabase-password@db.your-supabase-ref.supabase.co:5432/postgres

# Or individual parameters:
# PGHOST=db.your-supabase-ref.supabase.co
# PGUSER=postgres
# PGDATABASE=postgres
# PGPASSWORD=your-supabase-password
# PGPORT=5432

# Application Settings
JWT_SECRET=yourSuperSecretKey
PORT=5000

# Email (Nodemailer Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_here

# Cloudinary Image Upload
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional (Legacy MongoDB URI for running the one-time data migration script)
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

